@page "/error"
@using System.Diagnostics

<PageTitle>Error - Sistema de Ventas</PageTitle>

<h1 class="text-danger">Error.</h1>
<h2 class="text-danger">Se produjo un error al procesar la solicitud.</h2>

@if (MostrarRequestId)
{
    <p>
        <strong>ID de solicitud:</strong> <code>@RequestId</code>
    </p>
}

<h3>Modo de desarrollo</h3>
<p>
    Al cambiar al entorno de <strong>Desarrollo</strong> se muestra información detallada sobre el error ocurrido.
</p>

@code {
    [SupplyParameterFromQuery]
    private string? RequestId { get; set; }

    private bool MostrarRequestId => !string.IsNullOrEmpty(RequestId);
}