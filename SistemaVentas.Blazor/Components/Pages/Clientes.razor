@page "/clientes"
@attribute [Authorize]
@inject HttpClient Http

<PageTitle>Clientes - Sistema de Ventas</PageTitle>

<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold text-primary"><i class="bi bi-people me-2"></i>Gestión de Clientes</h2>
    </div>

    <div class="card shadow-sm p-3 mb-4 border-0">
        <h5 class="fw-bold">@(clienteActual.IdCliente == 0 ? "Nuevo Cliente" : "Editar Cliente")</h5>
        <EditForm Model="@clienteActual" OnValidSubmit="@GuardarCliente">
            <DataAnnotationsValidator />
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label fw-bold">Nombre</label>
                    <InputText @bind-Value="clienteActual.Nombre" class="form-control" placeholder="Ej. Juan" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Apellido</label>
                    <InputText @bind-Value="clienteActual.Apellido" class="form-control" placeholder="Ej. Pérez" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">NIT</label>
                    <InputText @bind-Value="clienteActual.Nit" class="form-control" placeholder="Ej. 1234567-8" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold">Teléfono</label>
                    <InputText @bind-Value="clienteActual.Telefono" class="form-control" placeholder="Ej. 55554444" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold">Correo</label>
                    <InputText @bind-Value="clienteActual.Correo" class="form-control" type="email" placeholder="cliente@correo.com" />
                </div>
                <div class="col-12 text-end">
                    <button type="submit" class="btn btn-success me-2 fw-bold"><i class="bi bi-save me-1"></i>Guardar</button>
                    <button type="button" class="btn btn-secondary fw-bold" @onclick="Limpiar">Cancelar</button>
                </div>
            </div>
        </EditForm>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Nombre Completo</th>
                        <th>NIT</th>
                        <th>Teléfono</th>
                        <th>Correo</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (clientes == null)
                    {
                        <tr><td colspan="6" class="text-center py-3">Cargando clientes...</td></tr>
                    }
                    else if (!clientes.Any())
                    {
                        <tr><td colspan="6" class="text-center py-3 text-muted">No hay clientes registrados.</td></tr>
                    }
                    else
                    {
                        @foreach (var c in clientes)
                        {
                            <tr>
                                <td>@c.IdCliente</td>
                                <td>@c.Nombre @c.Apellido</td>
                                <td>@c.Nit</td>
                                <td>@c.Telefono</td>
                                <td>@c.Correo</td>
                                <td class="text-center">
                                    <button class="btn btn-warning btn-sm me-1" @onclick="() => Editar(c)"><i class="bi bi-pencil"></i></button>
                                    <button class="btn btn-danger btn-sm" @onclick="() => Eliminar(c.IdCliente)"><i class="bi bi-trash"></i></button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private List<ClienteDTO>? clientes;
    private ClienteDTO clienteActual = new();

    protected override async Task OnInitializedAsync() => await CargarClientes();

    private async Task CargarClientes()
    {
        try { clientes = await Http.GetFromJsonAsync<List<ClienteDTO>>("api/Clientes"); } catch { clientes = new(); }
    }

    private async Task GuardarCliente()
    {
        if (clienteActual.IdCliente == 0)
            await Http.PostAsJsonAsync("api/Clientes", clienteActual);
        else
            await Http.PutAsJsonAsync($"api/Clientes/{clienteActual.IdCliente}", clienteActual);

        Limpiar();
        await CargarClientes();
    }

    private void Editar(ClienteDTO c) => clienteActual = new ClienteDTO
    {
        IdCliente = c.IdCliente, Nombre = c.Nombre, Apellido = c.Apellido,
        Nit = c.Nit, Telefono = c.Telefono, Correo = c.Correo
    };

    private async Task Eliminar(int id)
    {
        await Http.DeleteAsync($"api/Clientes/{id}");
        await CargarClientes();
    }

    private void Limpiar() => clienteActual = new();

    public class ClienteDTO
    {
        public int IdCliente { get; set; }
        public string Nombre { get; set; } = string.Empty;
        public string Apellido { get; set; } = string.Empty;
        public string? Nit { get; set; }
        public string? Telefono { get; set; }
        public string? Correo { get; set; }
    }
}