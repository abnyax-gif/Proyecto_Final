@page "/puestos"
@attribute [Authorize]
@inject HttpClient Http

<PageTitle>Puestos - Sistema de Ventas</PageTitle>

<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold text-primary"><i class="bi bi-person-workspace me-2"></i>Mantenimiento de Puestos</h2>
        <a href="/empleados" class="btn btn-outline-secondary fw-bold">
            <i class="bi bi-arrow-left me-1"></i> Ir a Empleados
        </a>
    </div>

    <div class="card shadow-sm p-3 mb-4 border-0">
        <h5 class="fw-bold">@(puestoActual.IdPuesto == 0 ? "Nuevo Puesto" : "Editar Puesto")</h5>
        <EditForm Model="@puestoActual" OnValidSubmit="@GuardarPuesto">
            <DataAnnotationsValidator />
            <div class="row g-3 align-items-center">
                <div class="col-md-8">
                    <label class="form-label fw-bold">Nombre del Puesto</label>
                    <InputText @bind-Value="puestoActual.NombrePuesto" class="form-control" placeholder="Ej. Vendedor, Administrador" required />
                </div>
                <div class="col-md-4 mt-4">
                    <button type="submit" class="btn btn-success me-2 fw-bold"><i class="bi bi-save me-1"></i>Guardar</button>
                    <button type="button" class="btn btn-secondary fw-bold" @onclick="Limpiar">Cancelar</button>
                </div>
            </div>
        </EditForm>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Nombre Puesto</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (puestos == null)
                    {
                        <tr><td colspan="3" class="text-center py-3">Cargando puestos...</td></tr>
                    }
                    else if (!puestos.Any())
                    {
                        <tr><td colspan="3" class="text-center py-3 text-muted">No hay puestos registrados.</td></tr>
                    }
                    else
                    {
                        @foreach (var p in puestos)
                        {
                            <tr>
                                <td>@p.IdPuesto</td>
                                <td>@p.NombrePuesto</td>
                                <td class="text-center">
                                    <button class="btn btn-warning btn-sm me-1" @onclick="() => Editar(p)"><i class="bi bi-pencil"></i></button>
                                    <button class="btn btn-danger btn-sm" @onclick="() => Eliminar(p.IdPuesto)"><i class="bi bi-trash"></i></button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private List<PuestoDTO>? puestos;
    private PuestoDTO puestoActual = new();

    protected override async Task OnInitializedAsync() => await CargarPuestos();

    private async Task CargarPuestos()
    {
        try { puestos = await Http.GetFromJsonAsync<List<PuestoDTO>>("api/Puestos"); } catch { puestos = new(); }
    }

    private async Task GuardarPuesto()
    {
        if (puestoActual.IdPuesto == 0)
            await Http.PostAsJsonAsync("api/Puestos", puestoActual);
        else
            await Http.PutAsJsonAsync($"api/Puestos/{puestoActual.IdPuesto}", puestoActual);

        Limpiar();
        await CargarPuestos();
    }

    private void Editar(PuestoDTO p) => puestoActual = new PuestoDTO { IdPuesto = p.IdPuesto, NombrePuesto = p.NombrePuesto };

    private async Task Eliminar(int id)
    {
        await Http.DeleteAsync($"api/Puestos/{id}");
        await CargarPuestos();
    }

    private void Limpiar() => puestoActual = new();

    public class PuestoDTO
    {
        public int IdPuesto { get; set; }
        public string NombrePuesto { get; set; } = string.Empty;
    }
}