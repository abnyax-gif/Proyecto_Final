@page "/compras"
@attribute [Authorize]
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Compras - Sistema de Ventas</PageTitle>

<div class="container py-3">
    <h2 class="fw-bold text-primary mb-3"><i class="bi bi-bag-check me-2"></i>Módulo de Nueva Compra</h2>

    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@mensajeError
            <button type="button" class="btn-close" @onclick="() => mensajeError = null"></button>
        </div>
    }

    <div class="row g-3 mb-4">
        <!-- Datos de la Compra -->
        <div class="col-md-6">
            <div class="card shadow-sm p-3 border-0">
                <h5 class="fw-bold mb-3">Datos del Comprobante / Proveedor</h5>
                <div class="mb-2">
                    <label class="form-label fw-bold">Proveedor</label>
                    <select class="form-select" @bind="idProveedorSeleccionado">
                        <option value="0">-- Seleccione Proveedor --</option>
                        @if (proveedores != null)
                        {
                            @foreach (var p in proveedores)
                            {
                                <option value="@p.IdProveedor">@p.NombreProveedor (@p.Nit)</option>
                            }
                        }
                    </select>
                </div>
                <div class="mb-2">
                    <label class="form-label fw-bold">Empleado Comprador</label>
                    <select class="form-select" @bind="idEmpleadoSeleccionado">
                        <option value="0">-- Seleccione Empleado --</option>
                        @if (empleados != null)
                        {
                            @foreach (var e in empleados)
                            {
                                <option value="@e.IdEmpleado">@e.Nombre @e.Apellido</option>
                            }
                        }
                    </select>
                </div>
            </div>
        </div>

        <!-- Agregar Producto -->
        <div class="col-md-6">
            <div class="card shadow-sm p-3 border-0">
                <h5 class="fw-bold mb-3">Agregar Producto a la Compra</h5>
                <div class="mb-2">
                    <label class="form-label fw-bold">Producto</label>
                    <select class="form-select" @bind="idProductoSeleccionado">
                        <option value="0">-- Seleccione Producto --</option>
                        @if (productos != null)
                        {
                            @foreach (var p in productos)
                            {
                                <option value="@p.IdProducto">@p.Descripcion (Stock Actual: @p.Existencia | Q @p.PrecioCosto.ToString("N2"))</option>
                            }
                        }
                    </select>
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-4">
                        <label class="form-label fw-bold">Cantidad</label>
                        <input type="number" min="1" class="form-control" @bind="cantidadAgregar" />
                    </div>
                    <div class="col-4">
                        <label class="form-label fw-bold">Precio Costo</label>
                        <input type="number" step="0.01" class="form-control" @bind="precioCostoAgregar" />
                    </div>
                    <div class="col-4 align-self-end">
                        <button class="btn btn-primary w-100 fw-bold" @onclick="AgregarProducto"><i class="bi bi-plus-lg me-1"></i>Agregar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Detalle de Compra -->
    <div class="card shadow-sm border-0 mb-3">
        <div class="card-header bg-dark text-white fw-bold">Detalle de la Compra</div>
        <div class="card-body p-0">
            <table class="table table-striped align-middle mb-0">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Precio Costo</th>
                        <th>Cantidad</th>
                        <th>Subtotal</th>
                        <th class="text-center">Quitar</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!detalles.Any())
                    {
                        <tr><td colspan="5" class="text-center py-3 text-muted">No se han agregado productos a la compra.</td></tr>
                    }
                    else
                    {
                        @foreach (var d in detalles)
                        {
                            <tr>
                                <td>@d.DescripcionProducto</td>
                                <td>Q @d.PrecioCosto.ToString("N2")</td>
                                <td>@d.Cantidad</td>
                                <td><strong>Q @((d.Cantidad * d.PrecioCosto).ToString("N2"))</strong></td>
                                <td class="text-center">
                                    <button class="btn btn-outline-danger btn-sm" @onclick="() => detalles.Remove(d)"><i class="bi bi-x-lg"></i></button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer bg-light d-flex justify-content-between align-items-center">
            <h4 class="fw-bold m-0 text-primary">Total: Q @detalles.Sum(x => x.Cantidad * x.PrecioCosto).ToString("N2")</h4>
            <button class="btn btn-success btn-lg fw-bold" @onclick="FinalizarCompra" disabled="@(!detalles.Any())">
                <i class="bi bi-check-circle me-1"></i> Confirmar Compra
            </button>
        </div>
    </div>
</div>

<!-- Modal Factura / Comprobante de Compra -->
@if (compraRealizada != null)
{
    <div class="modal fade show d-block bg-dark bg-opacity-50" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content p-4" id="facturaImp">
                <div class="text-center border-bottom pb-2 mb-3">
                    <h4 class="fw-bold">SISTEMA DE VENTAS S.A.</h4>
                    <p class="mb-0 text-muted">Comprobante de Ingreso / Compra No. #@compraRealizada.IdCompra</p>
                    <small>Fecha: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</small>
                </div>

                <div class="mb-3">
                    <p class="mb-1"><strong>Proveedor:</strong> @compraRealizada.NombreProveedor</p>
                    <p class="mb-1"><strong>Recibido por:</strong> @compraRealizada.NombreEmpleado</p>
                </div>

                <table class="table table-sm border-top">
                    <thead>
                        <tr>
                            <th>Cant.</th>
                            <th>Producto</th>
                            <th class="text-end">Costo Unid.</th>
                            <th class="text-end">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in compraRealizada.Detalles)
                        {
                            <tr>
                                <td>@item.Cantidad</td>
                                <td>@item.DescripcionProducto</td>
                                <td class="text-end">Q @item.PrecioCosto.ToString("N2")</td>
                                <td class="text-end">Q @((item.Cantidad * item.PrecioCosto).ToString("N2"))</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="text-end border-top pt-2 fw-bold h5">
                    Total Invertido: Q @compraRealizada.Total.ToString("N2")
                </div>

                <div class="d-flex justify-content-between mt-4 d-print-none">
                    <button class="btn btn-secondary fw-bold" @onclick="() => compraRealizada = null">Cerrar</button>
                    <button class="btn btn-primary fw-bold" @onclick="ImprimirFactura"><i class="bi bi-printer me-1"></i> Imprimir Comprobante</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<ProveedorDTO>? proveedores;
    private List<EmpleadoDTO>? empleados;
    private List<ProductoDTO>? productos;

    private int idProveedorSeleccionado = 0;
    private int idEmpleadoSeleccionado = 0;
    private int idProductoSeleccionado = 0;
    private int cantidadAgregar = 1;
    private decimal precioCostoAgregar = 0;
    private string? mensajeError;

    private List<DetalleItem> detalles = new();
    private CompraResumenDTO? compraRealizada;

    protected override async Task OnInitializedAsync()
    {
        try { proveedores = await Http.GetFromJsonAsync<List<ProveedorDTO>>("api/Proveedores"); } catch { }
        try { empleados = await Http.GetFromJsonAsync<List<EmpleadoDTO>>("api/Empleados"); } catch { }
        try { productos = await Http.GetFromJsonAsync<List<ProductoDTO>>("api/Productos"); } catch { }
    }

    private void AgregarProducto()
    {
        mensajeError = null;
        var prod = productos?.FirstOrDefault(p => p.IdProducto == idProductoSeleccionado);
        if (prod == null || cantidadAgregar <= 0) return;

        detalles.Add(new DetalleItem
        {
            IdProducto = prod.IdProducto,
            DescripcionProducto = prod.Descripcion,
            PrecioCosto = precioCostoAgregar > 0 ? precioCostoAgregar : prod.PrecioCosto,
            Cantidad = cantidadAgregar
        });
    }

    private async Task FinalizarCompra()
    {
        if (idProveedorSeleccionado == 0 || idEmpleadoSeleccionado == 0 || !detalles.Any()) return;

        var prov = proveedores?.FirstOrDefault(p => p.IdProveedor == idProveedorSeleccionado);
        var emp = empleados?.FirstOrDefault(e => e.IdEmpleado == idEmpleadoSeleccionado);

        var dto = new
        {
            IdProveedor = idProveedorSeleccionado,
            IdEmpleado = idEmpleadoSeleccionado,
            Total = detalles.Sum(x => x.Cantidad * x.PrecioCosto),
            Detalles = detalles.Select(d => new { d.IdProducto, d.Cantidad, d.PrecioCosto }).ToList()
        };

        var response = await Http.PostAsJsonAsync("api/Compras", dto);
        if (response.IsSuccessStatusCode)
        {
            compraRealizada = new CompraResumenDTO
            {
                IdCompra = Random.Shared.Next(100, 999), // O leer ID devuelto de la API
                NombreProveedor = prov != null ? prov.NombreProveedor : "Proveedor General",
                NombreEmpleado = emp != null ? $"{emp.Nombre} {emp.Apellido}" : "Empleado",
                Total = dto.Total,
                Detalles = new List<DetalleItem>(detalles)
            };

            detalles.Clear();
            idProveedorSeleccionado = 0;
            idEmpleadoSeleccionado = 0;
            idProductoSeleccionado = 0;
            productos = await Http.GetFromJsonAsync<List<ProductoDTO>>("api/Productos");
        }
    }

    private async Task ImprimirFactura() => await JS.InvokeVoidAsync("window.print");

    public class DetalleItem
    {
        public int IdProducto { get; set; }
        public string DescripcionProducto { get; set; } = string.Empty;
        public decimal PrecioCosto { get; set; }
        public int Cantidad { get; set; }
    }

    public class CompraResumenDTO
    {
        public int IdCompra { get; set; }
        public string NombreProveedor { get; set; } = "";
        public string NombreEmpleado { get; set; } = "";
        public decimal Total { get; set; }
        public List<DetalleItem> Detalles { get; set; } = new();
    }

    public class ProveedorDTO { public int IdProveedor { get; set; } public string NombreProveedor { get; set; } = string.Empty; public string? Nit { get; set; } }
    public class EmpleadoDTO { public int IdEmpleado { get; set; } public string Nombre { get; set; } = string.Empty; public string Apellido { get; set; } = string.Empty; }
    public class ProductoDTO { public int IdProducto { get; set; } public string Descripcion { get; set; } = string.Empty; public decimal PrecioCosto { get; set; } public int Existencia { get; set; } }
}