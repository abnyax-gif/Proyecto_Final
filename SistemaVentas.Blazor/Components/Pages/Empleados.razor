@page "/empleados"
@attribute [Authorize]
@inject HttpClient Http

<PageTitle>Empleados - Sistema de Ventas</PageTitle>

<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold text-primary"><i class="bi bi-person-badge me-2"></i>Gestión de Empleados</h2>
        <a href="/puestos" class="btn btn-outline-primary fw-bold">
            <i class="bi bi-person-workspace me-1"></i> Ir a Puestos
        </a>
    </div>

    <div class="card shadow-sm p-3 mb-4 border-0">
        <h5 class="fw-bold">@(empleadoActual.IdEmpleado == 0 ? "Nuevo Empleado" : "Editar Empleado")</h5>
        <EditForm Model="@empleadoActual" OnValidSubmit="@GuardarEmpleado">
            <DataAnnotationsValidator />
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label fw-bold">Nombre</label>
                    <InputText @bind-Value="empleadoActual.Nombre" class="form-control" placeholder="Ej. Mario" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Apellido</label>
                    <InputText @bind-Value="empleadoActual.Apellido" class="form-control" placeholder="Ej. López" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Puesto</label>
                    <InputSelect @bind-Value="empleadoActual.IdPuesto" class="form-select" required>
                        <option value="0">-- Seleccione Puesto --</option>
                        @if (puestos != null)
                        {
                            @foreach (var p in puestos)
                            {
                                <option value="@p.IdPuesto">@p.NombrePuesto</option>
                            }
                        }
                    </InputSelect>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold">Teléfono</label>
                    <InputText @bind-Value="empleadoActual.Telefono" class="form-control" placeholder="Ej. 44443333" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold">Correo</label>
                    <InputText @bind-Value="empleadoActual.Correo" class="form-control" type="email" placeholder="empleado@correo.com" />
                </div>
                <div class="col-12 text-end">
                    <button type="submit" class="btn btn-success me-2 fw-bold"><i class="bi bi-save me-1"></i>Guardar</button>
                    <button type="button" class="btn btn-secondary fw-bold" @onclick="Limpiar">Cancelar</button>
                </div>
            </div>
        </EditForm>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Nombre Completo</th>
                        <th>Puesto</th>
                        <th>Teléfono</th>
                        <th>Correo</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (empleados == null)
                    {
                        <tr><td colspan="6" class="text-center py-3">Cargando empleados...</td></tr>
                    }
                    else if (!empleados.Any())
                    {
                        <tr><td colspan="6" class="text-center py-3 text-muted">No hay empleados registrados.</td></tr>
                    }
                    else
                    {
                        @foreach (var e in empleados)
                        {
                            <tr>
                                <td>@e.IdEmpleado</td>
                                <td>@e.Nombre @e.Apellido</td>
                                <td><span class="badge bg-info text-dark">@e.NombrePuesto</span></td>
                                <td>@e.Telefono</td>
                                <td>@e.Correo</td>
                                <td class="text-center">
                                    <button class="btn btn-warning btn-sm me-1" @onclick="() => Editar(e)"><i class="bi bi-pencil"></i></button>
                                    <button class="btn btn-danger btn-sm" @onclick="() => Eliminar(e.IdEmpleado)"><i class="bi bi-trash"></i></button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private List<EmpleadoDTO>? empleados;
    private List<PuestoDTO>? puestos;
    private EmpleadoDTO empleadoActual = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarPuestos();
        await CargarEmpleados();
    }

    private async Task CargarPuestos()
    {
        try { puestos = await Http.GetFromJsonAsync<List<PuestoDTO>>("api/Puestos"); } catch { puestos = new(); }
    }

    private async Task CargarEmpleados()
    {
        try { empleados = await Http.GetFromJsonAsync<List<EmpleadoDTO>>("api/Empleados"); } catch { empleados = new(); }
    }

    private async Task GuardarEmpleado()
    {
        if (empleadoActual.IdPuesto == 0) return;

        if (empleadoActual.IdEmpleado == 0)
            await Http.PostAsJsonAsync("api/Empleados", empleadoActual);
        else
            await Http.PutAsJsonAsync($"api/Empleados/{empleadoActual.IdEmpleado}", empleadoActual);

        Limpiar();
        await CargarEmpleados();
    }

    private void Editar(EmpleadoDTO e) => empleadoActual = new EmpleadoDTO
    {
        IdEmpleado = e.IdEmpleado, Nombre = e.Nombre, Apellido = e.Apellido,
        Telefono = e.Telefono, Correo = e.Correo, IdPuesto = e.IdPuesto
    };

    private async Task Eliminar(int id)
    {
        await Http.DeleteAsync($"api/Empleados/{id}");
        await CargarEmpleados();
    }

    private void Limpiar() => empleadoActual = new();

    public class EmpleadoDTO
    {
        public int IdEmpleado { get; set; }
        public string Nombre { get; set; } = string.Empty;
        public string Apellido { get; set; } = string.Empty;
        public string? Telefono { get; set; }
        public string? Correo { get; set; }
        public int IdPuesto { get; set; }
        public string NombrePuesto { get; set; } = string.Empty;
    }

    public class PuestoDTO
    {
        public int IdPuesto { get; set; }
        public string NombrePuesto { get; set; } = string.Empty;
    }
}