@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

<div class="page">
    <AuthorizeView>
        <Authorized>
            <div class="sidebar">
                <NavMenu />
            </div>

            <main>
                <div class="top-row px-4 d-flex justify-content-between align-items-center bg-light border-bottom">
                    <span class="fw-bold text-secondary">
                        <i class="bi bi-person-circle me-1"></i> Hola, @(context.User.Identity?.Name ?? "Usuario")
                    </span>
                    <button class="btn btn-outline-danger btn-sm fw-bold" @onclick="CerrarSesion">
                        <i class="bi bi-box-arrow-right me-1"></i> Cerrar Sesión
                    </button>
                </div>

                <article class="content px-4 py-3">
                    @Body
                </article>
            </main>
        </Authorized>
        <NotAuthorized>
            <main>
                <article class="content px-4">
                    @Body
                </article>
            </main>
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    private async Task CerrarSesion()
    {
        var customAuth = (CustomAuthStateProvider)AuthStateProvider;
        await customAuth.MarcarComoCerradoSesion();
        Navigation.NavigateTo("login", true);
    }
}