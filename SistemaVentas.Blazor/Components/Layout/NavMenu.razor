@using Microsoft.AspNetCore.Components.Authorization

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold" href="">Sistema de Ventas</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <!-- Inicio -->
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill me-2" aria-hidden="true"></span> Inicio
            </NavLink>
        </div>

        <!-- Sección PRODUCTOS -->
        <div class="px-3 mt-3 text-muted fw-bold small text-uppercase">Productos</div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="marcas">
                <span class="bi bi-tags-fill me-2" aria-hidden="true"></span> Marcas
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="productos">
                <span class="bi bi-box-seam-fill me-2" aria-hidden="true"></span> Catálogo Productos
            </NavLink>
        </div>

        <!-- Sección VENTAS -->
        <div class="px-3 mt-3 text-muted fw-bold small text-uppercase">Ventas</div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="clientes">
                <span class="bi bi-people-fill me-2" aria-hidden="true"></span> Clientes
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="empleados">
                <span class="bi bi-person-badge-fill me-2" aria-hidden="true"></span> Empleados
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="ventas">
                <span class="bi bi-cart-plus-fill me-2" aria-hidden="true"></span> Nueva Venta
            </NavLink>
        </div>

        <!-- Sección COMPRAS (Solo Admin) -->
        <AuthorizeView Roles="Admin">
            <Authorized>
                <div class="px-3 mt-3 text-muted fw-bold small text-uppercase">Compras</div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="proveedores">
                        <span class="bi bi-truck me-2" aria-hidden="true"></span> Proveedores
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="compras">
                        <span class="bi bi-bag-check-fill me-2" aria-hidden="true"></span> Nueva Compra
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <!-- Sección REPORTES -->
        <div class="px-3 mt-3 text-muted fw-bold small text-uppercase">Reportes</div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="reportes">
                <span class="bi bi-file-earmark-bar-graph-fill me-2" aria-hidden="true"></span> Reportes
            </NavLink>
        </div>
    </nav>
</div>